meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/rag/collections
  body: json
  auth: none
}

body:json {
  {
    "name": "monolito-modular",
    "description": "Base de conhecimento sobre monolitos modulares"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.name: isString
}

script:post-response {
  bru.setEnvVar("collectionId", res.body.id);
}
