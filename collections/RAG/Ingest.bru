meta {
  name: Ingest
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/rag/ingest
  body: json
  auth: none
}

body:json {
  {
    "source": "https://codigosimples.net/2024/11/14/monolitos-modulares-abordagem-moderna-na-construcao-de-monolitos/"
  }
}

assert {
  res.status: eq 201
  res.body.message: isString
}
