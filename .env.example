LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_api_key_here

LLM_API_KEY=your_api_key_here 
LLM_MODEL=
EMBEDDINGS_MODEL=
LLM_MODEL_PROVIDER=
OLLAMA_BASE_URL=http://host.docker.internal:11434

LOGGING_LEVEL=INFO

# Dentro do Compose, o app alcança o banco pelo NOME DO SERVIÇO (`db`), não por
# 127.0.0.1. Use `db:5432` quando rodar via Docker; `127.0.0.1:5432` só se rodar
# o app fora do container conectando no Postgres exposto em dev.
POSTGRES_HOST=db:5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=not-a-database-dev
