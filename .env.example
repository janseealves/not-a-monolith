LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_api_key_here

LLM_API_KEY=your_api_key_here 
LLM_MODEL=
EMBEDDINGS_MODEL=
LLM_MODEL_PROVIDER=
OLLAMA_BASE_URL=http://host.docker.internal:11434

LOGGING_LEVEL=INFO

# Dentro do Compose, o app alcança o banco pelo NOME DO SERVIÇO (`db`), não por
# 127.0.0.1. Use `db:5432` quando rodar via Docker; `127.0.0.1:5432` só se rodar
# o app fora do container conectando no Postgres exposto em dev.
POSTGRES_HOST=db:5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=not-a-database-dev

# ─── Object store (MinIO) ───
# Credenciais do MinIO. Em prd, troque por um service account com escopo só
# neste bucket em vez das credenciais root.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=documents
# Endpoint interno da rede do Compose: quem fala com o MinIO de dentro
# (o app e o mc do minio-init).
MINIO_ENDPOINT=http://minio:9000
# Host que o BROWSER alcança. É este que entra na assinatura da presigned URL —
# se divergir do endpoint usado para assinar, o MinIO devolve 403 sem explicar.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
