# Template de PRODUÇÃO (VPS). Copie para `.env` na VPS e preencha os secrets.
# Em prod NÃO há network_mode: host — o app fala com os outros serviços pelos
# nomes da rede do Compose (db, ollama), não por localhost.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=                          # secret

LLM_API_KEY=                                # secret: chave criada em ollama.com
LLM_MODEL=gpt-oss:120b                      # modelo do catálogo cloud (ajuste)
EMBEDDINGS_MODEL=embeddinggemma:300m        # idêntico ao dev (consistência do índice)
LLM_MODEL_PROVIDER=ollama

LLM_BASE_URL=https://ollama.com             # chat/inferência na cloud
EMBEDDINGS_BASE_URL=http://ollama:11434     # container ollama do compose

LOGGING_LEVEL=INFO

POSTGRES_HOST=db:5432                        # nome do serviço na rede do compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                           # secret
POSTGRES_DB=not-a-database
