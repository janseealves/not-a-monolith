# Template de PRODUÇÃO (VPS). Copie para `.env` na VPS e preencha os secrets.
# Em prod NÃO há network_mode: host — o app fala com os outros serviços pelos
# nomes da rede do Compose (db, ollama), não por localhost.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=                          # secret

LLM_API_KEY=                                # secret: chave criada em ollama.com
LLM_MODEL=gpt-oss:120b                      # modelo do catálogo cloud (ajuste)
EMBEDDINGS_MODEL=embeddinggemma:300m        # idêntico ao dev (consistência do índice)
LLM_MODEL_PROVIDER=ollama

LLM_BASE_URL=https://ollama.com             # chat/inferência na cloud
EMBEDDINGS_BASE_URL=http://ollama:11434     # container ollama do compose

LOGGING_LEVEL=INFO

POSTGRES_HOST=db:5432                        # nome do serviço na rede do compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                           # secret
POSTGRES_DB=not-a-database

# ─── Object store (MinIO) ───
MINIO_ROOT_USER=                             # secret: NÃO reaproveite o de dev
MINIO_ROOT_PASSWORD=                         # secret: idem
MINIO_BUCKET=documents

# Interno à rede do Compose — igual ao dev, o app fala pelo nome do serviço.
MINIO_ENDPOINT=http://minio:9000

# ⚠️ A ÚNICA linha que realmente muda em prd. É o host que o BROWSER acessa, e
# ele entra na assinatura da presigned URL: se não bater exatamente com a URL
# que o cliente abre, o MinIO devolve 403 sem dizer o motivo. Sem domínio, use
# http://<ip-da-vps>:9000; com proxy/TLS na frente, use https://<dominio> e
# lembre de atualizar aqui no dia em que o proxy entrar.
MINIO_PUBLIC_ENDPOINT=

MINIO_URL_TTL_SECONDS=900                    # validade do link, em segundos
